---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import AboutUs from '../components/AboutUs.astro';
import FeaturesAlternadas from '../components/FeaturesAlternadas.astro';
import ToursGrid from '../components/ToursGrid.astro';
import Stats from '../components/Stats.astro';
import Destinations from '../components/Destinations.astro';
import FAQ from '../components/FAQ.tsx';
import CTAFooter from '../components/CTAFooter.astro';
---

<Layout>
  <Navbar client:idle />
  <Hero />
  <AboutUs />
  <HowItWorks />
  <FeaturesAlternadas />
  <ToursGrid />
  <Stats />
  <Destinations />
  <FAQ client:visible />
  <CTAFooter />
</Layout>
