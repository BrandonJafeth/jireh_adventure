---
// Hero.astro — Pure Astro component, CSS-only animations, i18n with lang-es/lang-en spans
import { translations } from '../i18n/translations';
const h = translations.hero;
---

<section id="hero" class="hero-section">
  <!-- Decorative blobs -->
  <div class="hero-blob hero-blob--left" aria-hidden="true"></div>
  <div class="hero-blob hero-blob--right" aria-hidden="true"></div>
  <div class="hero-blob hero-blob--bottom" aria-hidden="true"></div>

  <div class="hero-content">

    <!-- Heading -->
    <h1 class="font-heading font-[900] uppercase leading-[0.92] tracking-[0.03em] mx-auto" style="font-size: clamp(3rem, 11vw, 9.5rem); max-width: 100vw; overflow-wrap: break-word;">
      <span class="block text-[#0B3D5E]" style="animation: fade-up 0.7s ease both; animation-delay: 0.15s;">NOT JUST A TOUR.</span>
      <span class="block text-[#0B3D5E]" style="animation: fade-up 0.7s ease both; animation-delay: 0.27s;">AN UNFORGETTABLE</span>
      <span class="block text-[#1A9E75]" style="animation: fade-up 0.7s ease both; animation-delay: 0.39s;">EXPERIENCE.</span>
    </h1>

    <!-- Subtext -->
    <p class="font-body font-light text-base md:text-lg text-[#0B3D5E]/70 leading-relaxed max-w-xl mx-auto mt-8" style="animation: fade-up 0.6s ease both; animation-delay: 0.6s;">
      <span class="lang-es">{h.sub1.es}<br />{h.sub2.es}</span>
      <span class="lang-en">{h.sub1.en}<br />{h.sub2.en}</span>
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10" style="animation: fade-up 0.6s ease both; animation-delay: 0.85s;">
      <a
        href="https://wa.me/50600000000?text=Hola!%20Quiero%20reservar%20un%20tour"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#1A9E75] text-white rounded-full px-6 py-3.5 font-body font-semibold text-sm tracking-wider uppercase inline-flex items-center gap-2 hover:bg-[#158a65] transition-colors"
      >
        Book Your Adventure
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
      </a>
      <a
        href="#tours"
        class="liquid-glass-strong rounded-full px-6 py-3.5 border border-[#0B3D5E]/15 font-body font-semibold text-sm tracking-wider uppercase text-[#0B3D5E] hover:bg-white/60 transition-colors"
      >
        <span class="lang-es">{h.cta2.es}</span>
        <span class="lang-en">{h.cta2.en}</span>
      </a>
    </div>

    <!-- Stats Bar -->
    <div class="mt-16 pt-10 border-t border-[#0B3D5E]/10 inline-flex gap-12 md:gap-16 justify-center" style="animation: fade-up 0.6s ease both; animation-delay: 1.0s;">
      <div class="text-center">
        <span class="font-heading font-[800] text-4xl text-[#0B3D5E] block">500+</span>
        <span class="font-body font-light text-xs tracking-wide text-[#0B3D5E]/55 uppercase mt-1.5 block">
          <span class="lang-es">{h.stat1l.es}</span>
          <span class="lang-en">{h.stat1l.en}</span>
        </span>
      </div>
      <div class="text-center">
        <span class="font-heading font-[800] text-4xl text-[#F5A623] block">5★</span>
        <span class="font-body font-light text-xs tracking-wide text-[#0B3D5E]/55 uppercase mt-1.5 block">
          <span class="lang-es">{h.stat2l.es}</span>
          <span class="lang-en">{h.stat2l.en}</span>
        </span>
      </div>
      <div class="text-center">
        <span class="font-heading font-[800] text-4xl text-[#0B3D5E] block">3</span>
        <span class="font-body font-light text-xs tracking-wide text-[#0B3D5E]/55 uppercase mt-1.5 block">
          <span class="lang-es">{h.stat3l.es}</span>
          <span class="lang-en">{h.stat3l.en}</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2" aria-hidden="true">
    <div class="w-px h-12 overflow-hidden relative">
      <div class="w-full h-3 bg-[#0B3D5E]/25 rounded-full" style="animation: scroll-line 2s ease-in-out infinite;"></div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
    position: relative;
    background:
      radial-gradient(circle, rgba(11,61,94,0.06) 1px, transparent 1px),
      linear-gradient(160deg,
        hsl(36 33% 95%) 0%,
        hsl(185 40% 90%) 40%,
        hsl(161 30% 88%) 100%
      );
    background-size: 28px 28px, 100% 100%;
    padding: 6rem 1.5rem 4rem;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 72rem;
    width: 100%;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
    transform: translateZ(0); /* Hardware acceleration */
  }

  .hero-blob--left {
    width: 500px;
    height: 380px;
    top: 10%;
    left: -5%;
    background: radial-gradient(ellipse, #1A9E75 0%, transparent 70%);
    opacity: 0.09;
    filter: blur(80px);
    animation: pulse-soft 8s ease-in-out infinite;
  }

  .hero-blob--right {
    width: 420px;
    height: 320px;
    top: 20%;
    right: -3%;
    background: radial-gradient(ellipse, #3AB8D8 0%, transparent 70%);
    opacity: 0.12;
    filter: blur(70px);
    animation: pulse-soft 10s ease-in-out infinite 2s;
  }

  .hero-blob--bottom {
    width: 600px;
    height: 200px;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%) translateZ(0);
    background: radial-gradient(ellipse, #0B3D5E 0%, transparent 70%);
    opacity: 0.05;
    filter: blur(90px);
  }

  @keyframes pulse-soft {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.09;
    }
    50% {
      transform: translate3d(0, 0, 0) scale(1.05);
      opacity: 0.12;
    }
  }
</style>
