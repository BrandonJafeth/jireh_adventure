---
// Hero.astro — Pure Astro component, CSS-only animations, i18n with lang-es/lang-en spans
import { translations } from '../i18n/translations';
const h = translations.hero;
---

<section id="hero" class="hero-section">
  <!-- Static Image Background (LCP Optimized) -->
  <img
    srcset="
      https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1777137161/pexels-asadphoto-1430675_obuwlc.jpg 800w,
      https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_1920/v1777137161/pexels-asadphoto-1430675_obuwlc.jpg 1920w
    "
    sizes="100vw"
    src="https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_1920/v1777137161/pexels-asadphoto-1430675_obuwlc.jpg"
    alt="Jet ski and ATV adventure tours in Playa Flamingo, Guanacaste, Costa Rica – Jireh Adventure"
    class="hero-image absolute inset-0 w-full h-full object-cover object-center z-0"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <!-- Overlays -->
  <!-- Capa 1: Tono general (más opacidad blanca para legibilidad sin sombras) -->
  <div class="absolute inset-0 z-10" style="background: linear-gradient(160deg, rgba(247,243,238,0.55) 0%, rgba(11,61,94,0.15) 100%)"></div>
  <!-- Capa 2: Fade bottom hacia background -->
  <div class="absolute bottom-0 left-0 right-0 h-[40%] z-10" style="background: linear-gradient(to bottom, transparent, hsl(36 33% 95%))"></div>

  <!-- Decorative blobs -->
  <div class="hero-blob hero-blob--left" aria-hidden="true"></div>
  <div class="hero-blob hero-blob--right" aria-hidden="true"></div>

  <div class="hero-content">
    
    <!-- Heading -->
    <h1 class="font-heading font-[900] uppercase leading-[0.92] tracking-[0.03em] mx-auto" style="font-size: clamp(3rem, 11vw, 9.5rem); max-width: 100vw; overflow-wrap: break-word;">
      <span class="block text-[#0B3D5E]" style="animation: fade-up 0.7s ease both; animation-delay: 0.15s;">
        <span class="lang-es" aria-hidden="true">{h.h1_1.es}</span>
        <span class="lang-en">{h.h1_1.en}</span>
      </span>
      <span class="block text-[#0B3D5E]" style="animation: fade-up 0.7s ease both; animation-delay: 0.27s;">
        <span class="lang-es" aria-hidden="true">{h.h1_2.es}</span>
        <span class="lang-en">{h.h1_2.en}</span>
      </span>
      <span class="block text-[#1A9E75]" style="animation: fade-up 0.7s ease both; animation-delay: 0.39s;">
        <span class="lang-es" aria-hidden="true">{h.h1_3.es}</span>
        <span class="lang-en">{h.h1_3.en}</span>
      </span>
    </h1>

    <!-- Subtext -->
    <p class="font-body font-light text-base md:text-lg text-[#0B3D5E]/85 leading-relaxed max-w-xl mx-auto mt-8" style="animation: fade-up 0.6s ease both; animation-delay: 0.6s;">
      <span class="lang-es">{h.sub1.es}<br />{h.sub2.es}</span>
      <span class="lang-en">{h.sub1.en}<br />{h.sub2.en}</span>
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10" style="animation: fade-up 0.6s ease both; animation-delay: 0.85s;">
      <a
        href="https://wa.me/50686684823?text=Hola!%20Quisiera%20reservar%20una%20aventura%20con%20Jireh%20Adventure"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#1A9E75] text-white rounded-full px-6 py-3.5 font-body font-semibold text-sm tracking-wider uppercase inline-flex items-center justify-center gap-2 hover:bg-[#158a65] transition-colors"
      >
        <span class="lang-es">{h.cta1.es}</span>
        <span class="lang-en">{h.cta1.en}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
      </a>
      <a
        href="#tours"
        class="liquid-glass-strong rounded-full px-6 py-3.5 border border-[#0B3D5E]/15 font-body font-semibold text-sm tracking-wider uppercase text-[#0B3D5E] hover:bg-white/60 transition-colors"
      >
        <span class="lang-es">{h.cta2.es}</span>
        <span class="lang-en">{h.cta2.en}</span>
      </a>
    </div>

    <!-- Stats Bar -->
    <div class="mt-16 pt-10 border-t border-[#0B3D5E]/10 inline-flex gap-12 md:gap-16 justify-center" style="animation: fade-up 0.6s ease both; animation-delay: 1.0s;">
      <div class="text-center">
        <span class="font-heading font-[800] text-4xl text-[#0B3D5E] block">
          <span class="lang-es">{h.stat1v.es}</span>
          <span class="lang-en">{h.stat1v.en}</span>
        </span>
        <span class="font-body font-light text-xs tracking-wide text-[#0B3D5E]/70 uppercase mt-1.5 block">
          <span class="lang-es">{h.stat1l.es}</span>
          <span class="lang-en">{h.stat1l.en}</span>
        </span>
      </div>
      <div class="text-center">
        <span class="font-heading font-[800] text-4xl text-[#F5A623] block">
          <span class="lang-es">{h.stat2v.es}</span>
          <span class="lang-en">{h.stat2v.en}</span>
        </span>
        <span class="font-body font-light text-xs tracking-wide text-[#0B3D5E]/70 uppercase mt-1.5 block">
          <span class="lang-es">{h.stat2l.es}</span>
          <span class="lang-en">{h.stat2l.en}</span>
        </span>
      </div>
      <div class="text-center">
        <span class="font-heading font-[800] text-4xl text-[#0B3D5E] block">
          <span class="lang-es">{h.stat3v.es}</span>
          <span class="lang-en">{h.stat3v.en}</span>
        </span>
        <span class="font-body font-light text-xs tracking-wide text-[#0B3D5E]/70 uppercase mt-1.5 block">
          <span class="lang-es">{h.stat3l.es}</span>
          <span class="lang-en">{h.stat3l.en}</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2" aria-hidden="true" style="z-index: 20;">
    <div class="w-px h-12 overflow-hidden relative">
      <div class="w-full h-3 bg-[#0B3D5E]/25 rounded-full" style="animation: scroll-line 2s ease-in-out infinite;"></div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
    position: relative;
    padding: 6rem 1.5rem 4rem;
  }

  .hero-content {
    position: relative;
    z-index: 20;
    max-width: 72rem;
    width: 100%;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
    transform: translateZ(0); /* Hardware acceleration */
    z-index: 10;
  }

  .hero-blob--left {
    width: 500px;
    height: 380px;
    top: 10%;
    left: -5%;
    background: radial-gradient(ellipse, #1A9E75 0%, transparent 70%);
    opacity: 0.06;
    filter: blur(80px);
    animation: pulse-soft 8s ease-in-out infinite;
  }

  .hero-blob--right {
    width: 420px;
    height: 320px;
    top: 20%;
    right: -3%;
    background: radial-gradient(ellipse, #3AB8D8 0%, transparent 70%);
    opacity: 0.08;
    filter: blur(70px);
    animation: pulse-soft 10s ease-in-out infinite 2s;
  }

  @keyframes pulse-soft {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(0, 0, 0) scale(1.05);
    }
  }
</style>
